{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #shopify-section-{{ section.id }} .clarimento-tabs__input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .clarimento-tabs__header {
    display: grid;
    gap: 1rem;
    margin-bottom: 2.4rem;
    max-width: 76rem;
  }

  #shopify-section-{{ section.id }} .clarimento-tabs__heading {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .clarimento-tabs__description {
    max-width: 58rem;
  }

  #shopify-section-{{ section.id }} .clarimento-tabs__nav {
    align-items: center;
    border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.18);
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin-bottom: 2.4rem;
  }

  #shopify-section-{{ section.id }} .clarimento-tabs__tab {
    border-bottom: 0.2rem solid transparent;
    color: rgba(var(--color-foreground), 0.62);
    cursor: pointer;
    font: inherit;
    font-weight: 600;
    line-height: 1;
    margin-bottom: -0.1rem;
    min-height: 4.4rem;
    padding: 1.4rem 1.8rem;
  }

  #shopify-section-{{ section.id }} .clarimento-tabs__tab:hover {
    color: rgb(var(--color-foreground));
  }

  #shopify-section-{{ section.id }} .clarimento-tabs__panel {
    display: none;
  }

  {%- for block in section.blocks -%}
    #ClarimentoTab-{{ section.id }}-{{ block.id }}:checked ~ .clarimento-tabs__nav label[for="ClarimentoTab-{{ section.id }}-{{ block.id }}"] {
      border-bottom-color: rgb(var(--color-foreground));
      color: rgb(var(--color-foreground));
    }

    #ClarimentoTab-{{ section.id }}-{{ block.id }}:checked ~ .clarimento-tabs__panels #ClarimentoPanel-{{ section.id }}-{{ block.id }} {
      display: block;
    }
  {%- endfor -%}

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .clarimento-tabs__header {
      align-items: end;
      grid-template-columns: minmax(0, 1fr) minmax(28rem, 42rem);
    }

    #shopify-section-{{ section.id }} .clarimento-tabs__description {
      justify-self: end;
    }
  }
{%- endstyle -%}

<div class="clarimento-tabs color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="clarimento-tabs__header">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="caption-with-letter-spacing">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="clarimento-tabs__heading inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
      </div>
      {%- if section.settings.description != blank -%}
        <div class="clarimento-tabs__description rte">
          {{ section.settings.description }}
        </div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="clarimento-tabs__interactive">
        {%- for block in section.blocks -%}
          <input
            class="clarimento-tabs__input"
            type="radio"
            id="ClarimentoTab-{{ section.id }}-{{ block.id }}"
            name="ClarimentoTabs-{{ section.id }}"
            {% if forloop.first %}checked{% endif %}
          >
        {%- endfor -%}

        <div class="clarimento-tabs__nav" role="tablist" aria-label="{{ section.settings.heading | strip_html | escape }}">
          {%- for block in section.blocks -%}
            {%- liquid
              assign tab_label = block.settings.tab_label
              if tab_label == blank and block.settings.collection != blank
                assign tab_label = block.settings.collection.title
              endif
            -%}
            <label
              class="clarimento-tabs__tab"
              for="ClarimentoTab-{{ section.id }}-{{ block.id }}"
              role="tab"
              {{ block.shopify_attributes }}
            >
              {{ tab_label | default: 'Collection' | escape }}
            </label>
          {%- endfor -%}
        </div>

        <div class="clarimento-tabs__panels">
          {%- for block in section.blocks -%}
            <div
              class="clarimento-tabs__panel"
              id="ClarimentoPanel-{{ section.id }}-{{ block.id }}"
              role="tabpanel"
            >
              <ul
                class="grid product-grid contains-card contains-card--product{% if settings.card_style == 'standard' %} contains-card--standard{% endif %} grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down"
                role="list"
              >
                {%- if block.settings.collection != blank and block.settings.collection.products.size > 0 -%}
                  {%- for product in block.settings.collection.products limit: section.settings.products_to_show -%}
                    <li class="grid__item">
                      {% render 'card-product',
                        card_product: product,
                        media_aspect_ratio: section.settings.image_ratio,
                        image_shape: 'default',
                        show_secondary_image: section.settings.show_secondary_image,
                        show_vendor: section.settings.show_vendor,
                        show_rating: section.settings.show_rating,
                        section_id: section.id,
                        quick_add: section.settings.quick_add,
                        product_view_context: 'collection'
                      %}
                    </li>
                  {%- endfor -%}
                {%- else -%}
                  {%- for i in (1..section.settings.columns_desktop) -%}
                    <li class="grid__item">
                      {%- liquid
                        assign ridx = forloop.rindex
                        case ridx
                          when 5
                            assign ridx = 1
                          when 6
                            assign ridx = 2
                        endcase
                        assign placeholder_image = 'product-apparel-' | append: ridx
                      -%}
                      {% render 'card-product',
                        media_aspect_ratio: section.settings.image_ratio,
                        placeholder_image: placeholder_image,
                        show_vendor: section.settings.show_vendor
                      %}
                    </li>
                  {%- endfor -%}
                {%- endif -%}
              </ul>

              {%- if block.settings.button_label != blank -%}
                <div class="center collection__view-all">
                  <a
                    class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                    {% if block.settings.button_link == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.button_link }}"
                    {% endif %}
                  >
                    {{ block.settings.button_label | escape }}
                  </a>
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Clarimento product tabs",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Shop Clarimento"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Thoughtful essentials, selected for clear routines and easy gifting.</p>"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Products to show"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Desktop columns"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "2",
      "label": "Mobile columns"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "adapt",
      "label": "Image ratio"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": true,
      "label": "Show second image on hover"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "Show vendor"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "Show rating"
    },
    {
      "type": "select",
      "id": "quick_add",
      "default": "standard",
      "label": "Quick add",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "standard",
          "label": "Standard"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "collection_tab",
      "name": "Collection tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_label",
          "label": "Tab label",
          "default": "Featured"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "View all"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary",
          "default": true,
          "label": "Use outline button"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Clarimento product tabs",
      "blocks": [
        {
          "type": "collection_tab",
          "settings": {
            "tab_label": "New"
          }
        },
        {
          "type": "collection_tab",
          "settings": {
            "tab_label": "Best"
          }
        },
        {
          "type": "collection_tab",
          "settings": {
            "tab_label": "Sets"
          }
        }
      ]
    }
  ]
}
{% endschema %}
